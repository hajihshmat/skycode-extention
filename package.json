{
  "name": "skycode",
  "displayName": "SkyCode",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skycode-container",
          "title": "SkyCode",
          "icon": "media/skycode.svg"
        }
      ]
    },
    "views": {
      "skycode-container": [
        {
          "type": "webview",
          "id": "skycode.sidebar",
          "name": "SkyCode"
        }
      ]
    },
    "commands": [
      {
        "command": "skycode.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "skycode.settings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "skycode.account",
        "title": "Account",
        "icon": "$(account)"
      },
      {
        "command": "skycode.history",
        "title": "History",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skycode.settings",
          "group": "navigation",
          "when": "view == skycode.sidebar"
        },
        {
          "command": "skycode.account",
          "group": "navigation",
          "when": "view == skycode.sidebar"
        },
        {
          "command": "skycode.history",
          "group": "navigation",
          "when": "view == skycode.sidebar"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:tailwind",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tailwind": "tailwindcss -i src/webview/styles.css -o media/webview.css --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "build:tailwind": "tailwindcss -i src/webview/styles.css -o media/webview.css --minify",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.132.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
